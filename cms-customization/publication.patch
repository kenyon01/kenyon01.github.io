@@ -0,0 +1,84 @@
+// @vitest-environment happy-dom
+import { afterEach, expect, test, vi } from 'vitest';
+import { mount, unmount, tick } from 'svelte';
+import ServerVideo from './server-video.svelte';
+import { user } from '$lib/services/user/account.svelte';
+
+vi.mock('$lib/services/user/account.svelte', () => ({ user: { account: { backendName: 'github', token: 'test-token' } } }));
+let component;
+let request;
+const changed = vi.fn();
+class Upload {
+  upload = {};
+  open = vi.fn();
+  setRequestHeader = vi.fn();
+  send = vi.fn();
+  abort = vi.fn(() => this.onabort?.());
+  constructor() { request = this; }
+}
+const button = text => [...document.querySelectorAll('button')].find(b => b.textContent === text);
+async function open(file, readonly = false) {
+  vi.stubGlobal('XMLHttpRequest', Upload);
+  component = mount(ServerVideo, { target: document.body, props: { onUploaded: changed, readonly } });
+  await tick();
+  const input = document.querySelector('input');
+  Object.defineProperty(input, 'files', { configurable: true, value: [file] });
+  input.dispatchEvent(new Event('change', { bubbles: true }));
+  await tick();
+}
+afterEach(async () => {
+  if (component) await unmount(component);
+  document.body.innerHTML = '';
+  changed.mockClear();
+  vi.unstubAllGlobals();
+  user.account = { backendName: 'github', token: 'test-token' };
+});
+
+test('uploads bytes to Tencent and returns only the resulting URL', async () => {
+  const file = new File(['sample'], '实验.mp4', { type: 'video/mp4' });
+  await open(file);
+  button('上传视频到腾讯云').click();
+  await tick();
+  expect(request.open).toHaveBeenCalledWith('POST', 'https://www.nlearn.net/robot-media/api/videos');
+  expect(request.send).toHaveBeenCalledWith(file);
+  expect(request.setRequestHeader).toHaveBeenCalledWith('Authorization', 'Bearer test-token');
+  expect(changed).not.toHaveBeenCalled();
+  request.status = 201;
+  const url = 'https://www.nlearn.net/robot-media/videos/' + 'a'.repeat(64) + '.mp4';
+  request.responseText = JSON.stringify({ url });
+  request.onload();
+  await tick();
+  expect(changed).toHaveBeenCalledWith(url);
+  expect(document.body.textContent).toContain('请保存文章');
+});
+test('failed uploads preserve the article value and allow retry', async () => {
+  await open(new File(['x'], 'test.mp4'));
+  button('上传视频到腾讯云').click();
+  request.status = 401;
+  request.responseText = JSON.stringify({ error: '登录已过期' });
+  request.onload();
+  await tick();
+  expect(changed).not.toHaveBeenCalled();
+  expect(document.body.textContent).toContain('登录已过期');
+  expect(button('上传视频到腾讯云').disabled).toBe(false);
+});
+test('readonly disables uploads and choosing existing videos', async () => {
+  await open(new File(['x'], 'test.mp4'), true);
+  expect(button('上传视频到腾讯云').disabled).toBe(true);
+  expect(button('选择已上传视频').disabled).toBe(true);
+});
+test('sign-in is required and existing videos only fill a URL', async () => {
+  await open(new File(['x'], 'test.mp4'));
+  user.account = null;
+  button('上传视频到腾讯云').click();
+  await tick();
+  expect(changed).not.toHaveBeenCalled();
+  expect(document.body.textContent).toContain('请先登录');
+  user.account = { backendName: 'github', token: 'test-token' };
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue({ ok: true, json: async () => ({ videos: [{ url: 'https://www.nlearn.net/robot-media/videos/test.mp4', name: '已有视频', size: 1024 }] }) }));
+  button('选择已上传视频').click();
+  await vi.waitFor(() => expect(document.body.textContent).toContain('已有视频'));
+  [...document.querySelectorAll('li button')][0].click();
+  await tick();
+  expect(changed).toHaveBeenCalledWith('https://www.nlearn.net/robot-media/videos/test.mp4');
+});
