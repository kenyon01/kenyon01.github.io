+  /** @import { Entry, InternalEntryCollection } from '$lib/types/private'; */
+  /** @type {{ collection: InternalEntryCollection, entry: Entry }} */
+  let { collection, entry } = $props();
+  let busy = $state(false);
+  let message = $state('');
+  let failed = $state(false);
+  let reading = $state(false);
+  let confirming = $state(false);
+  const published = $derived(isPublished(entry, collection));
+  const publicAccess = $derived(isPublic(entry, collection));
+
+  const changeVisibility = async () => {
+    if (busy) return;
+    confirming = false;
+    busy = true;
+    failed = false;
+    try {
+      await setVisibility(collection, entry, publicAccess ? 'private' : 'public');
+      message = '权限已保存，公开网站需等待同步完成';
+    } catch {
+      failed = true;
+      message = '权限保存失败，请刷新并重试';
+    } finally {
+      busy = false;
+    }
+  };
+
+  /** @param {boolean} next Target visibility. */
+  const changePublication = async (next) => {
+    if (busy) return;
+    busy = true;
+    failed = false;
+    message = next ? '正在上架…' : '正在下架…';
+    try {
+      await setPublication(collection, entry, next);
+      message = '已保存，公开网站需等待同步完成';
+    } catch (error) {
+      failed = true;
+      message =
+        error instanceof Error && error.message === 'save_conflict'
+          ? '文章有新修改，请刷新后重试'
+          : error instanceof Error && error.message === 'validation_failed'
+            ? '请先编辑并补全必填内容'
+            : '操作失败，请检查网络后重试';
+    } finally {
+      busy = false;
+    }
+  };
+</script>
