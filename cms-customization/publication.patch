diff --git a/src/lib/components/contents/details/fields/string/server-video.svelte b/src/lib/components/contents/details/fields/string/server-video.svelte
new file mode 100644
index 0000000..f315375
--- /dev/null
+++ b/src/lib/components/contents/details/fields/string/server-video.svelte
@@ -0,0 +1,98 @@
+<script>
+  import { onDestroy } from 'svelte';
+  import { user } from '$lib/services/user/account.svelte';
+
+  let { onUploaded, readonly = false } = $props();
+  let selected = $state();
+  let busy = $state(false);
+  let progress = $state(0);
+  let message = $state('');
+  let failed = $state(false);
+  let records = $state([]);
+  let xhr;
+  let active = true;
+  const endpoint = 'https://www.nlearn.net/robot-media/api/videos';
+  onDestroy(() => { active = false; xhr?.abort(); });
+
+  function token() {
+    if (user.account?.backendName !== 'github' || !user.account?.token) throw new Error('请先登录 GitHub 写作后台。');
+    return user.account.token;
+  }
+
+  async function list() {
+    failed = false;
+    try {
+      const response = await fetch(endpoint, { headers: { Authorization: `Bearer ${token()}` }, signal: AbortSignal.timeout(15000) });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || '读取失败，请重试。');
+      if (!active) return;
+      records = data.videos;
+      message = records.length ? '点击已有视频即可填入链接。' : '还没有上传的视频。';
+    } catch (error) { if (active) { failed = true; message = error.message; } }
+  }
+
+  function upload() {
+    if (!selected || busy || readonly) return;
+    failed = false;
+    if (!/\.mp4$/i.test(selected.name) || selected.size > 200 * 1024 ** 2 || !selected.size) {
+      failed = true; message = '请选择不超过 200MB 的 MP4 视频。'; return;
+    }
+    let auth;
+    try { auth = token(); } catch (error) { failed = true; message = error.message; return; }
+    busy = true; progress = 0; message = '正在上传到腾讯云…';
+    xhr = new XMLHttpRequest();
+    xhr.open('POST', endpoint);
+    xhr.timeout = 15 * 60 * 1000;
+    xhr.setRequestHeader('Authorization', `Bearer ${auth}`);
+    xhr.setRequestHeader('Content-Type', 'video/mp4');
+    xhr.setRequestHeader('X-File-Name', encodeURIComponent(selected.name));
+    xhr.upload.onprogress = event => {
+      if (!active) return;
+      if (event.lengthComputable) progress = Math.round(event.loaded * 100 / event.total);
+      if (progress === 100) message = '上传完成，正在验证视频格式…';
+    };
+    const finish = (text) => { if (active) { busy = false; failed = true; message = text; } };
+    xhr.onerror = () => finish('网络连接失败，请重试；也可查看已上传视频确认是否成功。');
+    xhr.ontimeout = () => finish('上传超时，请重试；也可查看已上传视频确认是否成功。');
+    xhr.onabort = () => finish('上传已取消。');
+    xhr.onload = () => {
+      if (!active) return;
+      busy = false;
+      try {
+        const data = JSON.parse(xhr.responseText);
+        if (xhr.status !== 201) throw new Error(data.error || '上传失败，请重试。');
+        onUploaded(data.url);
+        message = '视频已保存到腾讯云，链接已填入。请保存文章。';
+      } catch (error) { failed = true; message = error.message; }
+    };
+    xhr.send(selected);
+  }
+</script>
+
+<div class="server-video">
+  <p>视频保存在腾讯云，GitHub 只保存链接。仅上传可公开展示的视频：知道链接的人都能观看，文章设为私有不会隐藏视频。</p>
+  <label>选择视频（MP4，最多 200MB）<input type="file" accept="video/mp4,.mp4" disabled={busy || readonly} onchange={event => { selected = event.currentTarget.files?.[0]; message = ''; }} /></label>
+  <div class="actions">
+    <button type="button" disabled={!selected || busy || readonly} onclick={upload}>上传视频到腾讯云</button>
+    {#if busy}<button type="button" onclick={() => xhr?.abort()}>取消上传</button>{/if}
+    <button type="button" disabled={busy || readonly} onclick={list}>选择已上传视频</button>
+  </div>
+  {#if busy}<progress max="100" value={progress} aria-label="视频上传进度"></progress><span>{progress}%</span>{/if}
+  {#if message}<p role={failed ? 'alert' : 'status'}>{message}</p>{/if}
+  {#if records.length}
+    <ul>{#each records as record}<li><button type="button" disabled={busy || readonly} onclick={() => { onUploaded(record.url); records = []; message = '链接已填入，请保存文章。'; }}>{record.name}（{(record.size / 1024 ** 2).toFixed(1)} MB）</button></li>{/each}</ul>
+  {/if}
+</div>
+
+<style>
+  .server-video { margin-block: 8px 14px; padding: 14px; border: 1px solid #8886; border-radius: 8px; }
+  p { font-size: 13px; line-height: 1.6; margin: 0 0 10px; }
+  label { display: grid; gap: 8px; }
+  input { max-width: 100%; }
+  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
+  button { font: inherit; color: inherit; background: transparent; border: 1px solid #8888; border-radius: 6px; padding: 6px 10px; cursor: pointer; }
+  button:disabled { opacity: .5; cursor: default; }
+  progress { width: 75%; margin-inline-end: 8px; }
+  ul { max-height: 220px; overflow: auto; padding-inline-start: 20px; }
+  li { margin-block: 6px; overflow-wrap: anywhere; }
+</style>
diff --git a/src/lib/components/contents/details/fields/string/server-video.test.js b/src/lib/components/contents/details/fields/string/server-video.test.js
new file mode 100644
index 0000000..8958128
