@@ -0,0 +1,38 @@
+import { createRawState } from '$lib/services/utils/state.svelte';
+
+/** Selected topic IDs for the chapter list, kept for this browser session. */
+export const chapterTopicSelection = createRawState([]);
+
+/**
+ * Build filter choices from managed topics, including topics hidden from the main navigation.
+ * @param {import('$lib/types/private').Entry[]} entries Topic entries.
+ * @returns {{value: string, label: string}[]} Choices in topic order.
+ */
+export const getChapterTopicOptions = (entries) =>
+  entries
+    .map((entry) => {
+      const content = entry.locales._default?.content ?? {};
+
+      return { value: entry.slug, label: content.title || entry.slug, order: content.order ?? 50 };
+    })
+    .sort((a, b) => a.order - b.order || a.label.localeCompare(b.label, 'zh-CN', { numeric: true }))
+    .map(({ value, label }) => ({ value, label }));
+
+/**
+ * Match selected topic IDs with OR semantics, without changing other collections.
+ * @param {import('$lib/types/private').Entry[]} entries Chapters to filter.
+ * @param {import('$lib/types/private').InternalEntryCollection} collection Current collection.
+ * @param {string[]} [selection] Selected topic IDs; empty means all chapters.
+ * @returns {import('$lib/types/private').Entry[]} Matching entries.
+ */
+export const filterChapterTopics = (
+  entries,
+  collection,
+  selection = chapterTopicSelection.current,
+) => {
+  if (collection.name !== 'chapters' || !selection.length) return entries;
+
+  return entries.filter((entry) =>
+    selection.includes(entry.locales[collection._i18n.defaultLocale]?.content.topic),
+  );
+};
