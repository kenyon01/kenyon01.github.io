+<script>
+  import { onMount } from 'svelte';
+  import DOMPurify from 'isomorphic-dompurify';
+  import { Marked } from 'marked';
+  import { getAssetByPath } from '$lib/services/assets';
+  import { getAssetBlobURL } from '$lib/services/assets/info';
+
+  let { collection, entry, onClose } = $props();
+  let dialog;
+  let html = $state('');
+  let error = $state('');
+  const content = $derived(entry.locales[collection._i18n.defaultLocale].content);
+
+  onMount(() => {
+    let active = true;
+    dialog.showModal();
+    const render = async () => {
+      // No raw HTML or external embeds; images use authenticated repository reads.
+      const markdown = new Marked({
+        renderer: {
+          html: () => '',
+          image: ({ href }) =>
+            `<span data-reader-image="${encodeURIComponent(href)}">[图片]</span>`,
+        },
+      });
+      const safe = DOMPurify.sanitize(await markdown.parse(String(content.body ?? '')));
+      const document = new DOMParser().parseFromString(safe, 'text/html');
+      await Promise.all(
+        [...document.querySelectorAll('[data-reader-image]')].map(async (placeholder) => {
+          const value = decodeURIComponent(placeholder.getAttribute('data-reader-image'));
+          if (!value.startsWith('/article-media/')) {
+            placeholder.textContent = '[外部图片未加载]';
+            return;
+          }
+          const asset = getAssetByPath({ value, entry, collectionName: collection.name });
+        const url = asset ? await getAssetBlobURL(asset).catch(() => undefined) : undefined;
+          if (!url?.startsWith('blob:')) {
+            placeholder.textContent = '[图片加载失败]';
+            return;
+          }
+          const image = document.createElement('img');
+          image.src = url;
+          image.alt = '文章图片';
+          placeholder.replaceWith(image);
+        }),
+      );
+      document.querySelectorAll('a').forEach((link) => {
+        link.target = '_blank';
+        link.rel = 'noopener noreferrer';
+        if (!/^https?:\/\//i.test(link.getAttribute('href') ?? '')) link.removeAttribute('href');
+      });
+      if (active) html = document.body.innerHTML;
+    };
+    render().catch(() => {
+      if (active) error = '内容加载失败，请关闭后重试。';
+    });
+    return () => {
+      active = false;
+    };
+  });
+</script>
+
+<dialog
+  bind:this={dialog}
+  onclose={onClose}
+  onclick={(event) => event.stopPropagation()}
+  onkeydown={(event) => event.stopPropagation()}
+  aria-label="阅读文章"
+>
+  <header>
+    <span>后台阅读 · {content.visibility === 'public' ? '公开' : '私有'}</span><button
+      onclick={() => dialog.close()}>关闭阅读</button
+    >
+  </header>
+  <article>
+    <h1>{content.title}</h1>
+    <p class="description">{content.description}</p>
+    {#if error}<p role="alert">{error}</p>{:else if html}<div class="body">
+        {@html html}
+      </div>{:else}<p role="status">加载中…</p>{/if}
+  </article>
+</dialog>
+
+<style>
+  dialog {
+    width: min(800px, 92vw);
+    max-height: 88vh;
+    padding: 24px;
+    border: 1px solid #666;
+    border-radius: 12px;
+    background: #171b20;
+    color: #e9eef1;
+    text-align: left;
+    white-space: normal;
+  }
+  dialog::backdrop {
+    background: #0009;
+  }
+  header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 16px;
+  }
+  button {
+    padding: 8px 12px;
+    cursor: pointer;
+  }
+  article {
+    line-height: 1.8;
+    overflow-wrap: anywhere;
+  }
+  h1 {
+    font-size: 30px;
+    line-height: 1.3;
+    margin: 32px 0 16px;
+  }
+  .description {
+    color: #9faeb9;
+  }
+  .body :global(img) {
+    max-width: 100%;
+    height: auto;
+  }
+  .body :global(pre) {
+    overflow: auto;
+    padding: 16px;
+    background: #0b0f14;
+  }
+  .body :global(a) {
+    color: #78b9ff;
+  }
+</style>
