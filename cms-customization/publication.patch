+++ b/src/lib/components/contents/list/publication-actions.svelte
@@ -0,0 +1,135 @@
+<script>
+  import { goto } from '$lib/services/app/navigation';
+  import { isPublished, setPublication } from '$lib/services/contents/entry/publication';
+
+  /** @import { Entry, InternalEntryCollection } from '$lib/types/private'; */
+  /** @type {{ collection: InternalEntryCollection, entry: Entry }} */
+  let { collection, entry } = $props();
+  let busy = $state(false);
+  let message = $state('');
+  let failed = $state(false);
+  const published = $derived(isPublished(entry, collection));
+
+  /** @param {boolean} next Target visibility. */
+  const changePublication = async (next) => {
+    if (busy) return;
+    busy = true;
+    failed = false;
+    message = next ? '正在上架…' : '正在下架…';
+    try {
+      await setPublication(collection, entry, next);
+      message = '已保存，网站更新中';
+    } catch (error) {
+      failed = true;
+      message =
+        error instanceof Error && error.message === 'save_conflict'
+          ? '文章有新修改，请刷新后重试'
+          : error instanceof Error && error.message === 'validation_failed'
+            ? '请先编辑并补全必填内容'
+            : '操作失败，请检查网络后重试';
+    } finally {
+      busy = false;
+    }
+  };
+</script>
+
+<div class="publication">
+  <span class:published class="badge">{published ? '已上架' : '未上架'}</span>
+  <div class="actions">
+    <button
+      disabled={busy || published}
+      onclick={(event) => {
+        event.stopPropagation();
+        changePublication(true);
+      }}
+      onkeydown={(event) => event.stopPropagation()}>上架</button
+    >
+    <button
+      disabled={busy || !published}
+      onclick={(event) => {
+        event.stopPropagation();
+        changePublication(false);
+      }}
+      onkeydown={(event) => event.stopPropagation()}>下架</button
+    >
+    <button
+      disabled={busy}
+      onclick={(event) => {
+        event.stopPropagation();
+        goto(`/collections/${collection.name}/entries/${entry.subPath}`, {
+          transitionType: 'forwards',
+        });
+      }}
+      onkeydown={(event) => event.stopPropagation()}>编辑</button
+    >
+  </div>
+  {#if message}<span class="message" class:failed role="status">{message}</span>{/if}
+</div>
+
+<style>
+  :global(.grid-view) .publication {
+    min-width: 0;
+    max-width: 100%;
+    justify-content: flex-start;
+  }
+  :global(.grid-view) .actions { flex-wrap: wrap; }
+  .publication {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: flex-end;
+    align-items: center;
+    gap: 6px;
+    min-width: 200px;
+    padding: 5px 0;
+  }
+  .badge {
+    border: 1px solid #87939b;
+    color: inherit;
+    border-radius: 12px;
+    padding: 2px 7px;
+    font-size: 12px;
+  }
+  .badge.published {
+    color: #15966b;
+    border-color: #15966b;
+  }
+  .actions {
+    display: flex;
+    gap: 5px;
+  }
+  button {
+    font: inherit;
+    font-size: 13px;
+    border: 1px solid #87939b;
+    border-radius: 5px;
+    padding: 5px 8px;
+    background: transparent;
+    color: inherit;
+    cursor: pointer;
+  }
+  button:hover:not(:disabled) {
+    background: #80808030;
+  }
+  button:disabled {
+    opacity: 0.35;
+    cursor: default;
+  }
+  button:focus-visible {
+    outline: 2px solid #4285f4;
+    outline-offset: 2px;
+  }
+  .message {
+    flex-basis: 100%;
+    white-space: normal;
+    font-size: 12px;
+  }
+  .failed {
+    color: #e97171;
+  }
+  @media (max-width: 600px) {
+    .publication {
+      min-width: 155px;
+      max-width: 180px;
+    }
+  }
+</style>
