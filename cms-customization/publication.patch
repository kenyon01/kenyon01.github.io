+<script>
+  import { selectedEntries } from '$lib/services/contents/collection/entries';
+  import { chapterTopicSelection } from '$lib/services/contents/collection/view/chapter-topics';
+
+  /** @type {{options: {value: string, label: string}[], disabled?: boolean}} */
+  const { options, disabled = false } = $props();
+
+  /**
+   * Clear selected rows when the visible set changes so hidden chapters are never counted.
+   * @param {string[]} selection Selected topic IDs.
+   */
+  const setSelection = (selection) => {
+    selectedEntries.current = [];
+    chapterTopicSelection.current = selection;
+  };
+</script>
+
+<fieldset class="chapter-topic-filter" {disabled}>
+  <legend>按栏目筛选</legend>
+  <button
+    type="button"
+    aria-pressed={!chapterTopicSelection.current.length}
+    onclick={() => setSelection([])}>全部栏目</button
+  >
+  {#each options as option (option.value)}
+    <label>
+      <input
+        type="checkbox"
+        checked={chapterTopicSelection.current.includes(option.value)}
+        onchange={(event) => {
+          setSelection(
+            event.currentTarget.checked
+              ? [...chapterTopicSelection.current, option.value]
+              : chapterTopicSelection.current.filter((value) => value !== option.value),
+          );
+        }}
+      />
+      <span>{option.label}</span>
+    </label>
+  {/each}
+  <span class="hint"
+    >{disabled
+      ? '同一上级内拖动或上下移动；完成后保存，也可取消'
