diff --git a/src/lib/services/contents/entry/publication.js b/src/lib/services/contents/entry/publication.js
new file mode 100644
index 0000000..dc38253
--- /dev/null
+++ b/src/lib/services/contents/entry/publication.js
@@ -0,0 +1,28 @@
+import { buildDraft } from '$lib/services/contents/draft/create';
+import { saveEntry } from '$lib/services/contents/draft/save';
+
+/** @import { Entry, InternalEntryCollection } from '$lib/types/private'; */
+
+/**
+ * Jekyll treats an absent published field as published.
+ * @param {Entry} entry Entry.
+ * @param {InternalEntryCollection} collection Collection.
+ * @returns {boolean} Whether the entry is published.
+ */
+export const isPublished = (entry, collection) =>
+  entry.locales[collection._i18n.defaultLocale]?.content.published !== false;
+
+/**
+ * Reuse the CMS save path, including conflict detection and store updates.
+ * @param {InternalEntryCollection} collection Collection.
+ * @param {Entry} entry Persisted entry.
+ * @param {boolean} published Target visibility.
+ * @returns {Promise<Entry>} Saved entry.
+ */
+export const setPublication = async (collection, entry, published) => {
+  const draft = buildDraft({ collection, originalEntry: entry });
+  Object.values(draft.currentValues).forEach((values) => {
+    values.published = published;
+  });
+  return saveEntry({ draft, skipCI: false });
+};
diff --git a/src/lib/services/contents/entry/publication.test.js b/src/lib/services/contents/entry/publication.test.js
