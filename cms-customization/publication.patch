+import { parse } from 'yaml';
+
+import { resolveChapterGraph } from '$lib/services/contents/chapter-graph';
+import { getEntriesByCollection } from '$lib/services/contents/collection/entries';
+
+/**
+ * Validate the resulting hierarchy and article references before committing changes.
+ * @param {object[]} changes Proposed Git file changes.
+ */
+export function assertChapterChanges(changes) {
+  const relevant = changes.filter((change) =>
+    /^\/?_(chapters|posts|topics)\/[^/]+\.md$/.test(change.path),
+  );
+
+  if (!relevant.length) return;
+
+  const state = Object.fromEntries(
+    ['chapters', 'posts', 'topics'].map((name) => [
+      name,
+      new Map(
+        getEntriesByCollection(name).map((entry) => [
+          entry.slug,
+          entry.locales._default?.content || {},
+        ]),
+      ),
+    ]),
+  );
+
+  relevant.forEach((change) => {
+    const previous = change.previousPath?.match(/^\/?_(chapters|posts|topics)\/([^/]+)\.md$/);
+
+    if (previous) state[previous[1]].delete(previous[2]);
+
+    const [, collection, id] = change.path.match(/^\/?_(chapters|posts|topics)\/([^/]+)\.md$/);
+
+    if (change.action === 'delete') {
+      state[collection].delete(id);
+      return;
+    }
+
+    if (typeof change.data !== 'string') throw new Error('栏目、章节和文章必须保存为文本。');
+
+    const parts = change.data.split(/^---\s*$/m);
+    const metadata = parts.length >= 3 ? parse(parts[1]) : undefined;
+
+    if (!metadata || typeof metadata !== 'object')
+      throw new Error('无法读取章节设置，请重新打开编辑器。');
+    state[collection].set(id, metadata);
+  });
+
+  const graph = resolveChapterGraph(
+    Object.fromEntries(state.chapters),
+    new Set(state.topics.keys()),
+  );
+
+  state.posts.forEach((post) => {
+    if (!post.chapter) return;
+
+    const chapter = graph.get(post.chapter);
+
+    if (!chapter) throw new Error('文章所属章节不存在，请重新选择章节。');
+    if (chapter.topic !== post.topic)
+      throw new Error('文章所属章节与栏目不一致，请选择当前栏目下的章节。');
+  });
+}
