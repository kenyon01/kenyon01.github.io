+++ b/src/lib/services/assets/video-policy.js
@@ -0,0 +1,19 @@
+/**
+ * Keep video binaries and oversized attachments out of the article repository.
+ * @param {import('$lib/types/private').FileChange[]} changes Proposed file changes.
+ */
+export function assertRepositoryMedia(changes) {
+  changes.forEach(({ action, path = '', data }) => {
+    if (action === 'delete') return;
+
+    const name = typeof File !== 'undefined' && data instanceof File ? data.name : '';
+
+    if (/\.(mp4|m4v|mov|webm|avi|mkv|mpeg|mpg|mts|m2ts|wmv|flv|ogv|3gp)$/i.test(path) || /\.(mp4|m4v|mov|webm|avi|mkv|mpeg|mpg|mts|m2ts|wmv|flv|ogv|3gp)$/i.test(name) || (data instanceof Blob && data.type.startsWith('video/'))) {
+      throw new Error('视频不能保存到 GitHub，请使用文章的「实验视频 → 上传视频到腾讯云」。');
+    }
+
+    if (data instanceof Blob && data.size > 10 * 1024 ** 2) {
+      throw new Error('普通附件最多 10MB。视频请使用「实验视频 → 上传视频到腾讯云」。');
+    }
+  });
+}
