+      onkeydown={(event) => event.stopPropagation()}
+      >{publicAccess ? '设为私有' : '设为公开'}</button
+    >
+    <button
+      disabled={busy || !published}
+      onclick={(event) => {
+        event.stopPropagation();
+        reading = true;
+      }}
+      onkeydown={(event) => event.stopPropagation()}>阅读</button
+    >
+    <button
+      disabled={busy || published}
+      onclick={(event) => {
+        event.stopPropagation();
+        changePublication(true);
+      }}
+      onkeydown={(event) => event.stopPropagation()}>上架</button
+    >
+    <button
+      disabled={busy || !published}
+      onclick={(event) => {
+        event.stopPropagation();
+        changePublication(false);
+      }}
+      onkeydown={(event) => event.stopPropagation()}>下架</button
+    >
+    <button
+      disabled={busy}
+      onclick={(event) => {
+        event.stopPropagation();
+        goto(`/collections/${collection.name}/entries/${entry.subPath}`, {
+          transitionType: 'forwards',
+        });
+      }}
+      onkeydown={(event) => event.stopPropagation()}>编辑</button
+    >
+  </div>
+  {#if confirming}
+    <div class="message" role="alert">
+      {publicAccess ? '转私有后需等待同步撤下；曾公开的历史副本无法收回。' : '公开并上架后，正文及引用图片将对所有人可见。'}
+      <button disabled={busy} onclick={(event) => { event.stopPropagation(); changeVisibility(); }} onkeydown={(event) => event.stopPropagation()}>确认{publicAccess ? '设为私有' : '设为公开'}</button>
+      <button onclick={(event) => { event.stopPropagation(); confirming = false; }} onkeydown={(event) => event.stopPropagation()}>取消</button>
+    </div>
+  {/if}
+  {#if message}<span class="message" class:failed role="status">{message} <a href="https://github.com/kenyon01/blog-private/actions" target="_blank" rel="noopener noreferrer" onclick={(event) => event.stopPropagation()} onkeydown={(event) => event.stopPropagation()}>查看同步结果</a></span>{/if}
+</div>
+{#if reading}<ArticleReader
+    {collection}
+    {entry}
+    onClose={() => {
+      reading = false;
+    }}
+  />{/if}
+
+<style>
+  :global(.grid-view) .publication {
+    min-width: 0;
+    max-width: 100%;
+    justify-content: flex-start;
+  }
+  :global(.grid-view) .actions {
+    flex-wrap: wrap;
+  }
+  .publication {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: flex-end;
+    align-items: center;
+    gap: 6px;
+    min-width: 200px;
+    padding: 5px 0;
+  }
+  .badge {
+    border: 1px solid #87939b;
+    color: inherit;
+    border-radius: 12px;
+    padding: 2px 7px;
+    font-size: 12px;
+  }
+  .badge.published {
+    color: #15966b;
+    border-color: #15966b;
+  }
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: flex-end;
+    gap: 5px;
+  }
+  button {
+    font: inherit;
+    font-size: 13px;
+    border: 1px solid #87939b;
+    border-radius: 5px;
+    padding: 5px 8px;
+    background: transparent;
+    color: inherit;
+    cursor: pointer;
+  }
+  button:hover:not(:disabled) {
+    background: #80808030;
+  }
+  button:disabled {
+    opacity: 0.35;
+    cursor: default;
+  }
+  button:focus-visible {
+    outline: 2px solid #4285f4;
+    outline-offset: 2px;
