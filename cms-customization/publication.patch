@@ -0,0 +1,66 @@
+import {
+  getManagedChapterOptions,
+  resolveChapterGraph,
+} from '$lib/services/contents/chapter-graph';
+import { getChapterTopicOptions } from '$lib/services/contents/collection/view/chapter-topics';
+
+/**
+ * Keep chapters in separate sibling groups while reusing the CMS drag and keyboard reorder UI.
+ * @param {import('$lib/types/private').Entry[]} entries Chapters in the selected topics.
+ * @param {import('$lib/types/private').Entry[]} topics Managed topic entries.
+ * @param {string} locale Content locale.
+ * @returns {{name: string, label: string, entries: import('$lib/types/private').Entry[]}[]} Groups.
+ */
+export const groupChapterSiblings = (entries, topics, locale) => {
+  /**
+   * Read the scalar chapter fields used by the hierarchy.
+   * @param {import('$lib/types/private').Entry} entry Chapter entry.
+   * @returns {object} Chapter metadata.
+   */
+  const contentOf = (entry) => entry.locales[locale]?.content ?? {};
+
+  const graph = resolveChapterGraph(
+    Object.fromEntries(entries.map((entry) => [entry.slug, contentOf(entry)])),
+  );
+
+  const groups = new Map();
+
+  entries.forEach((entry) => {
+    const { topic, parent = '' } = contentOf(entry);
+    const key = JSON.stringify([topic, parent || '']);
+
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(entry);
+  });
+
+  const options = getChapterTopicOptions(topics);
+  const knownTopics = new Set(options.map((option) => option.value));
+
+  // Keep a chapter visible even if the topic list is temporarily stale.
+  graph.forEach((chapter) => {
+    if (!knownTopics.has(chapter.topic)) {
+      options.push({ value: chapter.topic, label: chapter.topic });
+      knownTopics.add(chapter.topic);
+    }
+  });
+
+  return options.flatMap((topic) => {
+    const parents = [
+      '',
+      ...getManagedChapterOptions({ entries, topic: topic.value, locale }).map(
+        (option) => option.value,
+      ),
+    ];
+
+    return parents.flatMap((parent) => {
+      const name = JSON.stringify([topic.value, parent]);
+      const siblings = groups.get(name);
+
+      if (!siblings?.length) return [];
+
+      const path = parent ? graph.get(parent).path.join(' / ') : '一级章节';
+
+      return [{ name, label: `${topic.label} / ${path}`, entries: siblings }];
+    });
+  });
+};
