index 0000000..5006c23
--- /dev/null
+++ b/src/lib/services/contents/entry/publication.test.js
@@ -0,0 +1,34 @@
+import { beforeEach, expect, test, vi } from 'vitest';
+import { buildDraft } from '$lib/services/contents/draft/create';
+import { saveEntry } from '$lib/services/contents/draft/save';
+import { isPublished, setPublication } from './publication';
+
+vi.mock('$lib/services/contents/draft/create', () => ({ buildDraft: vi.fn() }));
+vi.mock('$lib/services/contents/draft/save', () => ({ saveEntry: vi.fn() }));
+
+const collection = { _i18n: { defaultLocale: '_default' } };
+const entry = { locales: { _default: { content: { title: 'Article', published: false } } } };
+
+beforeEach(() => vi.resetAllMocks());
+
+test.each([true, false, undefined])('badge matches Jekyll published=%s', (published) => {
+  expect(isPublished({ locales: { _default: { content: { published } } } }, collection))
+    .toBe(published !== false);
+});
+
+test.each([true, false])('changes visibility to %s without mutating persisted content', async (next) => {
+  const draft = { currentValues: { _default: structuredClone(entry.locales._default.content) } };
+  buildDraft.mockReturnValue(draft);
+  saveEntry.mockResolvedValue({ saved: true });
+  expect(await setPublication(collection, entry, next)).toEqual({ saved: true });
+  expect(draft.currentValues._default).toEqual({ title: 'Article', published: next });
+  expect(entry.locales._default.content.published).toBe(false);
+  expect(saveEntry).toHaveBeenCalledWith({ draft, skipCI: false });
+});
+
+test.each(['save_conflict', 'saving_failed', 'validation_failed'])('propagates %s without optimistic publication', async (reason) => {
+  buildDraft.mockReturnValue({ currentValues: { _default: structuredClone(entry.locales._default.content) } });
+  saveEntry.mockRejectedValue(new Error(reason));
+  await expect(setPublication(collection, entry, true)).rejects.toThrow(reason);
+  expect(entry.locales._default.content.published).toBe(false);
+});
