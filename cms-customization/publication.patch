+// @vitest-environment happy-dom
+import { afterEach, expect, test, vi } from 'vitest';
+import { mount, unmount } from 'svelte';
+import ArticleReader from './article-reader.svelte';
+import { getAssetBlobURL } from '$lib/services/assets/info';
+
+vi.mock('$lib/services/assets', () => ({ getAssetByPath: vi.fn(() => ({ path: 'article-media/a.png' })) }));
+vi.mock('$lib/services/assets/info', () => ({ getAssetBlobURL: vi.fn() }));
+let component;
+afterEach(async () => { if (component) await unmount(component); document.body.innerHTML = ''; vi.clearAllMocks(); });
+
+const open = (body) => {
+  HTMLDialogElement.prototype.showModal = vi.fn();
+  component = mount(ArticleReader, { target: document.body, props: {
+    collection: { name: 'posts', _i18n: { defaultLocale: '_default' } },
+    entry: { locales: { _default: { content: { title: 'Private title', body, visibility: 'private' } } } },
+    onClose: vi.fn(),
+  } });
+};
+
+test('a failed image does not hide private article text', async () => {
+  getAssetBlobURL.mockRejectedValue(new Error('network failure'));
+  open('Readable body\n\n![image](/article-media/a.png)');
+  await vi.waitFor(() => expect(document.body.textContent).toContain('图片加载失败'));
+  expect(document.body.textContent).toContain('Readable body');
+  expect(document.querySelector('img')).toBeNull();
+});
+
+test('reader strips active HTML, unsafe links and external image requests', async () => {
+  open('Readable body\n\n<script>alert(1)</script>\n\n![external](https://example.com/tracker.png)\n\n[unsafe](javascript:alert(1))');
+  await vi.waitFor(() => expect(document.body.textContent).toContain('外部图片未加载'));
+  expect(document.querySelector('script,img,iframe')).toBeNull();
+  expect(document.querySelector('a[href^="javascript:"]')).toBeNull();
+  expect(getAssetBlobURL).not.toHaveBeenCalled();
+});
