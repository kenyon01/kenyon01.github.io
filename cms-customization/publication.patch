diff --git a/src/lib/services/contents/chapter-graph.js b/src/lib/services/contents/chapter-graph.js
new file mode 100644
index 0000000..5b81e3c
--- /dev/null
+++ b/src/lib/services/contents/chapter-graph.js
@@ -0,0 +1,123 @@
+/**
+ * Validate chapter references and derive complete paths from stable chapter IDs.
+ * @param {Record<string, object>} definitions Stored chapter metadata keyed by stable ID.
+ * @param {Set<string>} [topics] Allowed topic IDs, when validating a save.
+ * @returns {Map<string, object>} Chapters with resolved paths and ancestor IDs.
+ */
+export function resolveChapterGraph(definitions, topics) {
+  const graph = new Map();
+  const siblings = new Set();
+
+  Object.entries(definitions).forEach(([id, raw]) => {
+    const title = typeof raw.title === 'string' ? raw.title.trim() : '';
+    const parent = raw.parent || '';
+    const order = raw.order ?? 50;
+
+    if (
+      typeof title !== 'string' ||
+      !title ||
+      title.length > 80 ||
+      typeof raw.topic !== 'string' ||
+      (topics && !topics.has(raw.topic)) ||
+      typeof parent !== 'string' ||
+      !Number.isInteger(order) ||
+      order < 1 ||
+      order > 10000
+    ) {
+      throw new Error('请填写有效的章节名称、所属栏目和顺序。');
+    }
+
+    const identity = JSON.stringify([raw.topic, parent, title]);
+
+    if (siblings.has(identity)) throw new Error('同一栏目、同一上级下已有同名章节，请修改名称。');
+    siblings.add(identity);
+    graph.set(id, { id, title, topic: raw.topic, parent, order });
+  });
+
+  /**
+   * Resolve one chapter after its parent.
+   * @param {string} id Chapter ID.
+   * @param {string[]} [trail] IDs currently being resolved.
+   * @returns {object} Resolved chapter.
+   * @throws {Error} When the hierarchy is cyclic, too deep or crosses topics.
+   */
+  const visit = (id, trail = []) => {
+    if (trail.includes(id))
+      throw new Error('章节不能作为自己或下级章节的上级，请重新选择上级章节。');
+
+    const chapter = graph.get(id);
+
+    if (chapter.path) return chapter;
+
+    let parent;
+
+    if (chapter.parent) {
+      if (!graph.has(chapter.parent)) throw new Error('上级章节不存在，请重新选择。');
+      parent = graph.get(chapter.parent);
+      if (parent.topic !== chapter.topic) throw new Error('上级章节必须属于同一个栏目。');
+      parent = visit(chapter.parent, [...trail, id]);
+    }
+
+    chapter.path = [...(parent?.path || []), chapter.title];
+    chapter.ancestors = [...(parent?.ancestors || []), id];
+    chapter.orderPath = [...(parent?.orderPath || []), chapter.order];
+    if (chapter.path.length > 8) throw new Error('章节层级最多支持 8 层。');
+    return chapter;
+  };
+
+  graph.forEach((chapter) => visit(chapter.id));
+  return graph;
+}
+
+/**
+ * Build readable choices in tree order for the selected topic.
+ * @param {object} options Picker inputs.
+ * @param {import('$lib/types/private').Entry[]} options.entries Saved and pending chapter entries.
+ * @param {string} options.topic Selected topic ID.
+ * @param {string} [options.excludeAncestor] Chapter being edited, excluded with its descendants.
+ * @param {string} options.locale Current content locale.
+ * @returns {object[]} Select options with full hierarchy labels.
+ */
+export function getManagedChapterOptions({ entries, topic, excludeAncestor, locale }) {
+  if (!topic) return [];
+
+  const definitions = Object.fromEntries(
+    entries.map((entry) => [
+      entry.slug,
+      entry.locales[locale]?.content || entry.locales._default?.content || {},
+    ]),
+  );
+
+  let graph;
+
+  try {
+    graph = resolveChapterGraph(definitions);
+  } catch {
+    return [];
+  }
+
+  return [...graph.values()]
+    .filter(
+      (chapter) =>
+        chapter.topic === topic &&
+        (!excludeAncestor || !chapter.ancestors.includes(excludeAncestor)),
+    )
+    .sort((a, b) => {
+      const length = Math.min(a.path.length, b.path.length);
+
+      for (let i = 0; i < length; i += 1) {
+        const difference =
+          a.orderPath[i] - b.orderPath[i] ||
+          a.path[i].localeCompare(b.path[i], 'zh-CN', { numeric: true });
+
+        if (difference) return difference;
+      }
+
+      return a.path.length - b.path.length;
+    })
+    .map((chapter) => ({
+      value: chapter.id,
+      label: chapter.path.join(' / '),
+      searchValue: chapter.path.join(' '),
+    }));
+}
