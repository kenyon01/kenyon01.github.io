+  expect(() =>
+    assertChapterChanges([
+      change('_topics/dsp.md', 'title: DSP'),
+      change('_chapters/new.md', 'title: 第一章\ntopic: dsp'),
+      change('_chapters/child.md', 'title: 概念\ntopic: dsp\nparent: new'),
+      change('_posts/new.md', 'topic: dsp\nchapter: child'),
+    ]),
+  ).not.toThrow();
+});
+it('supports moving a chapter file atomically with its references', () => {
+  expect(() =>
+    assertChapterChanges([
+      {
+        ...change('_chapters/renamed.md', 'title: 基础\ntopic: robotics'),
+        action: 'move',
+        previousPath: '_chapters/a.md',
