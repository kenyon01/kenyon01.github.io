+import { describe, expect, it } from 'vitest';
+
+import { getManagedChapterOptions, resolveChapterGraph } from './chapter-graph';
+
+/**
+ *
+ */
+const definitions = () => ({
+  a: { title: '第一章', topic: 'robotics', order: 10 },
+  b: { title: '接口', topic: 'robotics', parent: 'a', order: 20 },
+  c: { title: '第二章', topic: 'quant', order: 5 },
+});
+
+/**
+ * @param data
+ */
+const entries = (data) =>
+  Object.entries(data).map(([slug, content]) => ({ slug, locales: { _default: { content } } }));
+
+describe('managed chapter choices', () => {
+  it('shows complete paths only within the selected topic', () => {
+    expect(
+      getManagedChapterOptions({
+        entries: entries(definitions()),
+        topic: 'robotics',
+        locale: '_default',
+      }).map((o) => [o.value, o.label]),
+    ).toEqual([
+      ['a', '第一章'],
+      ['b', '第一章 / 接口'],
+    ]);
+    expect(
+      getManagedChapterOptions({
+        entries: entries(definitions()),
+        topic: undefined,
+        locale: '_default',
+      }),
+    ).toEqual([]);
+  });
+  it('excludes current chapter and all descendants from parent choices', () => {
+    expect(
+      getManagedChapterOptions({
+        entries: entries(definitions()),
+        topic: 'robotics',
+        excludeAncestor: 'a',
+        locale: '_default',
+      }),
+    ).toEqual([]);
+    expect(
+      getManagedChapterOptions({
+        entries: entries(definitions()),
+        topic: 'robotics',
+        excludeAncestor: 'b',
+        locale: '_default',
+      }).map((o) => o.value),
+    ).toEqual(['a']);
+  });
+  it('renaming and reparenting preserve IDs while labels follow the hierarchy', () => {
+    const data = definitions();
+
+    data.a.title = '基础';
+    expect(resolveChapterGraph(data).get('b').path).toEqual(['基础', '接口']);
+    data.b.parent = '';
+    expect(resolveChapterGraph(data).get('b').path).toEqual(['接口']);
+  });
+  it('rejects cycles, wrong topic, missing parents, duplicate siblings and over-depth trees', () => {
+    const cycle = definitions();
+
+    cycle.a.parent = 'b';
+
+    const cross = definitions();
+
+    cross.b.parent = 'c';
+
+    const missing = definitions();
+
+    missing.b.parent = 'missing';
+
+    const duplicates = definitions();
+
+    duplicates.d = { ...duplicates.b };
+
+    const deep = Object.fromEntries(
+      Array.from({ length: 9 }, (_, i) => [
+        String(i),
+        { title: String(i), topic: 'robotics', parent: i ? String(i - 1) : '' },
+      ]),
+    );
+
+    [cycle, cross, missing, duplicates, deep].forEach((data) =>
+      expect(() => resolveChapterGraph(data)).toThrow(),
+    );
+    expect(() => resolveChapterGraph(definitions(), new Set(['quant']))).toThrow();
+  });
+});
