+import { describe, expect, it } from 'vitest';
+import { assertRepositoryMedia } from './video-policy';
+
+describe('repository video policy', () => {
+  it('rejects renamed videos, video extensions, and oversized binary files', () => {
+    for (const change of [
+      { path: 'article-media/test.MP4', data: new Blob(['x']) },
+      { path: 'photo.png', data: new Blob(['x'], { type: 'video/mp4' }) },
+      { path: 'photo.png', data: new File(['x'], 'original.mov') },
+      { path: 'large.dat', data: new Blob([new Uint8Array(10 * 1024 ** 2 + 1)]) },
+    ]) expect(() => assertRepositoryMedia([{ action: 'create', ...change }])).toThrow();
+  });
+  it('allows posts with video URLs, normal images, and removal of old videos', () => {
+    expect(() => assertRepositoryMedia([
+      { action: 'create', path: '_posts/test.md', data: 'video_url: https://www.nlearn.net/robot-media/videos/test.mp4' },
+      { action: 'create', path: 'article-media/test.png', data: new Blob(['image'], { type: 'image/png' }) },
+      { action: 'delete', path: 'article-media/old.mp4' },
+    ])).not.toThrow();
+  });
+});
