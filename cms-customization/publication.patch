+import { describe, expect, it } from 'vitest';
+
+import { filterChapterTopics, getChapterTopicOptions } from './chapter-topics';
+
+const collection = { name: 'chapters', _i18n: { defaultLocale: '_default' } };
+/**
+ * @param slug
+ * @param content
+ */
+const entry = (slug, content) => ({ slug, locales: { _default: { content } } });
+
+const chapters = [
+  entry('root', { topic: 'robotics' }),
+  entry('child', { topic: 'robotics', parent: 'root' }),
+  entry('quant-chapter', { topic: 'quant' }),
+  entry('dsp-chapter', { topic: '数字信号处理' }),
+];
+
+describe('chapter topic filters', () => {
+  it('shows all with no selection, a complete selected topic, or the union of selected topics', () => {
+    expect(filterChapterTopics(chapters, collection, [])).toBe(chapters);
+    expect(filterChapterTopics(chapters, collection, ['robotics']).map((e) => e.slug)).toEqual([
+      'root',
+      'child',
+    ]);
+    expect(
+      filterChapterTopics(chapters, collection, ['quant', '数字信号处理']).map((e) => e.slug),
+    ).toEqual(['quant-chapter', 'dsp-chapter']);
+    expect(filterChapterTopics(chapters, collection, ['post-training'])).toEqual([]);
+  });
+  it('matches stable IDs exactly and leaves other collections unchanged', () => {
+    expect(filterChapterTopics(chapters, collection, ['robot'])).toEqual([]);
+    expect(filterChapterTopics(chapters, { ...collection, name: 'posts' }, ['quant'])).toBe(
+      chapters,
+    );
+  });
+  it('offers newly managed and hidden topics in order with their current names', () => {
+    expect(
+      getChapterTopicOptions([
+        entry('数字信号处理', { title: '数字信号处理', order: 40, show_in_nav: false }),
+        entry('quant', { title: '量化', order: 30 }),
+        entry('robotics', { title: '具身智能', order: 10 }),
+      ]),
+    ).toEqual([
+      { value: 'robotics', label: '具身智能' },
+      { value: 'quant', label: '量化' },
+      { value: '数字信号处理', label: '数字信号处理' },
+    ]);
+  });
+});
