+// @vitest-environment happy-dom
+import { mount, tick, unmount } from 'svelte';
+import { afterEach, expect, test, vi } from 'vitest';
+
+import { selectedEntries } from '$lib/services/contents/collection/entries';
+import { chapterTopicSelection } from '$lib/services/contents/collection/view/chapter-topics';
+
+import ChapterTopicFilter from './chapter-topic-filter.svelte';
+
+let component;
+
+vi.mock('$lib/services/contents/collection/entries', () => ({ selectedEntries: { current: [] } }));
+
+afterEach(async () => {
+  if (component) await unmount(component);
+  chapterTopicSelection.current = [];
+  selectedEntries.current = [];
+  document.body.innerHTML = '';
+});
+
+test('checkboxes combine topics, can uncheck the last option, and all clears every checkbox', async () => {
+  component = mount(ChapterTopicFilter, {
+    target: document.body,
+    props: {
+      options: [
+        { value: 'robotics', label: '具身智能' },
+        { value: 'quant', label: '量化' },
+      ],
+    },
+  });
+  await tick();
+
+  const [robotics, quant] = document.querySelectorAll('input');
+  const all = document.querySelector('button');
+
+  expect(all.getAttribute('aria-pressed')).toBe('true');
+  selectedEntries.current = [{ id: 'previous-chapter' }];
+  robotics.click();
+  await tick();
+  expect(selectedEntries.current).toEqual([]);
+  expect(chapterTopicSelection.current).toEqual(['robotics']);
+  quant.click();
+  await tick();
+  expect(chapterTopicSelection.current).toEqual(['robotics', 'quant']);
+  selectedEntries.current = [{ id: 'hidden-chapter' }];
+  all.click();
+  await tick();
+  expect(selectedEntries.current).toEqual([]);
+  expect(chapterTopicSelection.current).toEqual([]);
+  expect(robotics.checked || quant.checked).toBe(false);
+  quant.click();
+  await tick();
+  quant.click();
+  await tick();
+  expect(chapterTopicSelection.current).toEqual([]);
+  expect(all.getAttribute('aria-pressed')).toBe('true');
+});
+
+test('locks topic choices while an order is being edited', async () => {
+  chapterTopicSelection.current = ['robotics'];
+  component = mount(ChapterTopicFilter, {
+    target: document.body,
+    props: {
+      disabled: true,
+      options: [{ value: 'robotics', label: '具身智能' }],
+    },
+  });
+  await tick();
+  expect(document.querySelector('fieldset').disabled).toBe(true);
+  expect(document.body.textContent).toContain('同一上级内拖动或上下移动');
+  expect(chapterTopicSelection.current).toEqual(['robotics']);
+});
