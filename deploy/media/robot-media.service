[Unit]
Description=Qingyan authenticated video uploads
After=network.target

[Service]
User=robot-media
Group=caddy
ExecStart=/usr/bin/node /opt/robot-learning/media-service/server.mjs
Environment=MEDIA_ROOT=/opt/robot-learning/media
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/robot-learning/media
MemoryMax=256M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
